<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="underwater_test_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Native Gazebo Sim buoyancy: displaced volume is computed from link collision geometry. -->
    <plugin filename="gz-sim-buoyancy-system"
        name="gz::sim::systems::Buoyancy">
  <graded_buoyancy>
    <default_density>1025</default_density>

    <density_change>
      <above_depth>0</above_depth>
      <density>1.0</density>
    </density_change>
  </graded_buoyancy>
</plugin>
    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.65 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.3 -1</direction>
    </light>

    <model name="seabed">
      <static>true</static>
      <link name="floor">
        <pose>0 0 -3 0 0 0</pose>
        <collision name="floor_collision">
          <geometry><box><size>30 30 0.2</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>30 30 0.2</size></box></geometry>
          <material><ambient>0.32 0.25 0.16 1</ambient><diffuse>0.32 0.25 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual water surface only; no fluid forces are applied in this starter world. -->
    <model name="water_surface_visual">
      <static>true</static>
      <link name="surface">
        <pose>0 0 0 0 0 0</pose>
        <visual name="water">
          <geometry><box><size>30 30 0.015</size></box></geometry>
          <material>
            <ambient>0.05 0.25 0.38 0.22</ambient>
            <diffuse>0.05 0.25 0.38 0.22</diffuse>
            </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
