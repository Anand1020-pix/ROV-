<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z origin_z:=0">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
      <inertia ixx="${mass*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12.0}" iyz="0"
               izz="${mass*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="rov_base">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.42 0.32 0.16"/></geometry>
        <material name="rov_orange"><color rgba="0.95 0.30 0.06 1"/></material>
      </visual>
      <!-- Smaller watertight enclosure collision: visual dimensions are not the displaced volume. -->
      <collision name="pressure_hull_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.32 0.22 0.12"/></geometry>
      </collision>
      <!-- Low battery/payload center keeps the buoyant hull upright in the water. -->
      <xacro:box_inertial mass="16.27" x="0.42" y="0.32" z="0.16" origin_z="-0.12"/>
    </link>

    <link name="frame_link">
      <visual>
        <geometry><box size="0.62 0.46 0.035"/></geometry>
        <material name="frame_black"><color rgba="0.12 0.14 0.16 1"/></material>
      </visual>
      <!-- Four bars approximate an open frame; a solid bounding-box collision overestimates displacement. -->
      <collision name="front_frame_bar">
        <origin xyz="0 0.2125 0" rpy="0 0 0"/>
        <geometry><box size="0.62 0.035 0.035"/></geometry>
      </collision>
      <collision name="rear_frame_bar">
        <origin xyz="0 -0.2125 0" rpy="0 0 0"/>
        <geometry><box size="0.62 0.035 0.035"/></geometry>
      </collision>
      <collision name="left_frame_bar">
        <origin xyz="0.2925 0 0" rpy="0 0 0"/>
        <geometry><box size="0.035 0.39 0.035"/></geometry>
      </collision>
      <collision name="right_frame_bar">
        <origin xyz="-0.2925 0 0" rpy="0 0 0"/>
        <geometry><box size="0.035 0.39 0.035"/></geometry>
      </collision>
      <xacro:box_inertial mass="2.0" x="0.62" y="0.46" z="0.035"/>
    </link>
    <joint name="frame_fixed_joint" type="fixed">
      <parent link="base_link"/><child link="frame_link"/>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
