<?xml version="1.0"?>
<package format="3">
  <name>rov_bringup</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic and RViz bringup for the sediment collector ROV.</description>
  <maintainer email="maintainer@example.com">ROV Project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rov_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
